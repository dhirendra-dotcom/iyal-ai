# Keep Cloud Run source uploads small and free of local-only files.
.gcloudignore
.git
.git/**
**/.venv/**
**/venv/**
**/__pycache__/**
**/.pytest_cache/**
**/*.pyc
**/*.pyo
**/.env
**/.env.*
!**/.env.example
backend/demo_outputs/**
backend/artifacts/**
backend/tmp/**
backend/temp/**
data/**
**/node_modules/**
**/.next/**
dist/**
build/**
*.zip
*.tar
*.tar.gz
*.log
.vscode/**
.idea/**
.DS_Store
Thumbs.db
backend/tests/**
frontend-lite/tests/**
docs/**
scripts/**
README.md
RELEASE_NOTES*.md
BUILD_VERIFICATION.md
