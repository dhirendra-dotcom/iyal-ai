# Google Cloud / Vertex AI
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GCS_BUCKET=your-artifact-bucket

# Gemini models
GEMINI_MODEL=gemini-3.8-flash
GEMINI_SEGMENTATION_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# Market research
PRODUCT_SEARCH_ENABLED=true
PRODUCT_SEARCH_MODEL=gemini-3.8-flash
PRODUCT_SEARCH_COUNTRY=India
PRODUCT_SEARCH_TOP_K=4
PRODUCT_SEARCH_TIMEOUT_SECONDS=45
PRODUCT_SEARCH_RETRY_UNPARSEABLE=false

# CAD
OPENSCAD_BINARY=openscad

# Upload / streaming
MAX_UPLOAD_MB=80
MAX_TRANSCRIPTION_MB=10
SSE_HEARTBEAT_SECONDS=10

# Logging
ARTHISTICS_LOG_LEVEL=INFO
ARTHISTICS_LOG_FORMAT=auto

# Measurement / calibration
CALIBRATION_MARKER_DICTIONARY=DICT_4X4_50
CALIBRATION_MARKER_ID=23
CALIBRATION_MARKER_SIZE_MM=100
A4_SHORT_SIDE_MM=210
A4_LONG_SIDE_MM=297

# Managed sessions / memory
AGENT_PLATFORM_LOCATION=us-central1
VERTEX_SESSION_RUNTIME_ID=
VERTEX_MEMORY_BANK_ID=
MEMORY_ENABLED=false
SESSION_DB_URL=

# Optional support-booking email
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=
SUPPORT_EMAIL_FROM=